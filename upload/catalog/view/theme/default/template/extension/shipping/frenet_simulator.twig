<div class="form-group" id="frenet-simulator" data-error="{{ error_unavailable|escape }}" data-autofill="{{ autofill ? 1 : 0 }}">
  <label class="control-label" for="input-frenet-postcode">{{ entry_simulator_postcode }}</label>
  <div class="input-group">
    <input type="text" value="" placeholder="{{ placeholder_simulator_postcode|escape }}" id="input-frenet-postcode" class="form-control" inputmode="numeric" maxlength="10" autocomplete="postal-code" />
    <span class="input-group-btn">
      <button type="button" id="button-frenet-simulator" data-loading-text="{{ text_loading|escape }}" class="btn btn-default">{{ button_simulator }}</button>
    </span>
  </div>
  <div id="frenet-simulator-result"></div>
</div>
<script type="text/javascript"><!--
$('#input-frenet-postcode').one('focus', function() {
	var input = $(this);

	$.ajax({
		url: 'index.php?route=extension/shipping/frenet/postcode',
		dataType: 'json',
		success: function(json) {
			if (json['postcode'] && !input.val()) {
				input.val(json['postcode']);
			}
		}
	});
});

if ($('#frenet-simulator').data('autofill')) {
	$('#input-frenet-postcode').triggerHandler('focus');
}

$('#input-frenet-postcode').on('keydown', function(e) {
	if (e.keyCode == 13) {
		e.preventDefault();

		$('#button-frenet-simulator').trigger('click');
	}
});

$('#button-frenet-simulator').on('click', function() {
	var button = $(this);
	var simulator = $('#frenet-simulator');
	var result = $('#frenet-simulator-result');
	var unavailable = {error: {warning: simulator.data('error')}};

	var show = function(json) {
		if (json['error']) {
			if (json['error']['warning']) {
				result.append($('<div class="alert alert-danger"></div>').text(json['error']['warning']));
			}

			if (json['error']['postcode']) {
				simulator.find('.input-group').after($('<div class="text-danger frenet-simulator-error"></div>').text(json['error']['postcode']));
			}

			if (json['error']['quantity']) {
				$('#input-quantity').after($('<div class="text-danger frenet-simulator-error"></div>').text(json['error']['quantity']));
			}

			for (var i in json['error']['option']) {
				var element = $('#input-option' + i.replace('_', '-'));
				var message = $('<div class="text-danger frenet-simulator-error"></div>').text(json['error']['option'][i]);

				if (element.parent().hasClass('input-group')) {
					element.parent().after(message);
				} else {
					element.after(message);
				}
			}

			$('.frenet-simulator-error').parent().addClass('has-error');
		}

		if (json['quote']) {
			var tbody = $('<tbody></tbody>');

			for (var j = 0; j < json['quote'].length; j++) {
				tbody.append($('<tr></tr>').append($('<td></td>').text(json['quote'][j]['title']), $('<td class="text-right"></td>').text(json['quote'][j]['text'])));
			}

			result.append($('<table class="table table-striped table-condensed"></table>').append(tbody));
		}
	};

	$.ajax({
		url: 'index.php?route=extension/shipping/frenet/quote',
		type: 'post',
		data: $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea').serialize() + '&postcode=' + encodeURIComponent($('#input-frenet-postcode').val()),
		dataType: 'json',
		beforeSend: function() {
			var errors = $('.frenet-simulator-error');

			result.empty();
			errors.parent().removeClass('has-error');
			errors.remove();
			button.button('loading');
		},
		complete: function() {
			button.button('reset');
		},
		success: show,
		error: function(xhr) {
			var json;

			try {
				json = JSON.parse(xhr.responseText);
			} catch (e) {
				json = unavailable;
			}

			show(json && json['error'] ? json : unavailable);
		}
	});
});
//--></script>
