{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if migrated %}
    <div class="alert alert-info alert-dismissible" id="frenet-migrated"><i class="fa fa-info-circle"></i> {{ text_migrated }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if not token_saved %}
    <div class="alert alert-warning" id="frenet-token-required"><i class="fa fa-exclamation-triangle"></i> {{ text_token_required }} <a href="{{ panel_url|escape }}" target="_blank" rel="noopener noreferrer">{{ text_panel }}</a></div>
    {% endif %}
    {% if geo_zone_missing %}
    <div class="alert alert-warning" id="frenet-geo-zone-missing"><i class="fa fa-exclamation-triangle"></i> {{ text_geo_zone_missing }}</div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-token"><span data-toggle="tooltip" title="{{ help_token }}">{{ entry_token }}</span></label>
            <div class="col-sm-10">
              <input type="password" name="shipping_frenet_token" value="" placeholder="{% if token_saved %}{{ text_token_saved }}{% else %}{{ entry_token }}{% endif %}" id="input-token" class="form-control" autocomplete="new-password" />
              {% if error_token %}
              <div class="text-danger">{{ error_token }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-postcode">{{ entry_postcode }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_frenet_postcode" value="{{ shipping_frenet_postcode|escape }}" placeholder="{{ entry_postcode }}" id="input-postcode" class="form-control" />
              {% if error_postcode %}
              <div class="text-danger">{{ error_postcode }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-delivery-time"><span data-toggle="tooltip" title="{{ help_delivery_time }}">{{ entry_delivery_time }}</span></label>
            <div class="col-sm-10">
              <select name="shipping_frenet_delivery_time" id="input-delivery-time" class="form-control">
                {% if shipping_frenet_delivery_time %}
                <option value="1" selected="selected">{{ text_yes }}</option>
                <option value="0">{{ text_no }}</option>
                {% else %}
                <option value="1">{{ text_yes }}</option>
                <option value="0" selected="selected">{{ text_no }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-msg-prazo"><span data-toggle="tooltip" title="{{ help_msg_prazo }}">{{ entry_msg_prazo }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="shipping_frenet_msg_prazo" value="{{ shipping_frenet_msg_prazo|escape }}" placeholder="{{ placeholder_msg_prazo }}" id="input-msg-prazo" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-additional-days"><span data-toggle="tooltip" title="{{ help_additional_days }}">{{ entry_additional_days }}</span></label>
            <div class="col-sm-10">
              <input type="number" name="shipping_frenet_additional_days" value="{{ shipping_frenet_additional_days|escape }}" min="0" step="1" id="input-additional-days" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-weight-class"><span data-toggle="tooltip" title="{{ help_weight_class }}">{{ entry_weight_class }}</span></label>
            <div class="col-sm-10">
              <select name="shipping_frenet_weight_class_id" id="input-weight-class" class="form-control">
                {% for weight_class in weight_classes %}
                <option value="{{ weight_class.weight_class_id|escape }}"{% if weight_class.weight_class_id == shipping_frenet_weight_class_id %} selected="selected"{% endif %}>{{ weight_class.title|escape }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-length-class"><span data-toggle="tooltip" title="{{ help_length_class }}">{{ entry_length_class }}</span></label>
            <div class="col-sm-10">
              <select name="shipping_frenet_length_class_id" id="input-length-class" class="form-control">
                {% for length_class in length_classes %}
                <option value="{{ length_class.length_class_id|escape }}"{% if length_class.length_class_id == shipping_frenet_length_class_id %} selected="selected"{% endif %}>{{ length_class.title|escape }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-minimum-height"><span data-toggle="tooltip" title="{{ help_minimum_height }}">{{ entry_minimum_height }}</span></label>
            <div class="col-sm-10">
              <input type="number" name="shipping_frenet_minimum_height" value="{{ shipping_frenet_minimum_height|escape }}" min="0" step="any" required id="input-minimum-height" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-minimum-width"><span data-toggle="tooltip" title="{{ help_minimum_width }}">{{ entry_minimum_width }}</span></label>
            <div class="col-sm-10">
              <input type="number" name="shipping_frenet_minimum_width" value="{{ shipping_frenet_minimum_width|escape }}" min="0" step="any" required id="input-minimum-width" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-minimum-length"><span data-toggle="tooltip" title="{{ help_minimum_length }}">{{ entry_minimum_length }}</span></label>
            <div class="col-sm-10">
              <input type="number" name="shipping_frenet_minimum_length" value="{{ shipping_frenet_minimum_length|escape }}" min="0" step="any" required id="input-minimum-length" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-default-weight"><span data-toggle="tooltip" title="{{ help_default_weight }}">{{ entry_default_weight }}</span></label>
            <div class="col-sm-10">
              <input type="number" name="shipping_frenet_default_weight" value="{{ shipping_frenet_default_weight|escape }}" min="0" step="any" required id="input-default-weight" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-timeout"><span data-toggle="tooltip" title="{{ help_timeout }}">{{ entry_timeout }}</span></label>
            <div class="col-sm-10">
              <input type="number" name="shipping_frenet_timeout" value="{{ shipping_frenet_timeout|escape }}" min="{{ timeout_min }}" max="{{ timeout_max }}" step="1" required id="input-timeout" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-attempts"><span data-toggle="tooltip" title="{{ help_attempts }}">{{ entry_attempts }}</span></label>
            <div class="col-sm-10">
              <input type="number" name="shipping_frenet_attempts" value="{{ shipping_frenet_attempts|escape }}" min="{{ attempts_min }}" max="{{ attempts_max }}" step="1" required id="input-attempts" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-simulator"><span data-toggle="tooltip" title="{{ help_simulator }}">{{ entry_simulator }}</span></label>
            <div class="col-sm-10">
              <select name="shipping_frenet_simulator" id="input-simulator" class="form-control">
                {% if shipping_frenet_simulator %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-simulator-limit"><span data-toggle="tooltip" title="{{ help_simulator_limit }}">{{ entry_simulator_limit }}</span></label>
            <div class="col-sm-10">
              <input type="number" name="shipping_frenet_simulator_limit" value="{{ shipping_frenet_simulator_limit|escape }}" min="0" step="1" data-error="{{ error_simulator_limit_value|escape }}" id="input-simulator-limit" class="form-control" />
              {% if error_simulator_limit %}
              <div class="text-danger">{{ error_simulator_limit }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-virtual-fee"><span data-toggle="tooltip" title="{{ help_virtual_fee }}">{{ entry_virtual_fee }}</span></label>
            <div class="col-sm-10">
              <select name="shipping_frenet_virtual_fee" id="input-virtual-fee" class="form-control">
                {% if shipping_frenet_virtual_fee %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-virtual-fee-amount"><span data-toggle="tooltip" title="{{ help_virtual_fee_amount }}">{{ entry_virtual_fee_amount }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="shipping_frenet_virtual_fee_amount" value="{{ shipping_frenet_virtual_fee_amount|escape }}" placeholder="4.90" id="input-virtual-fee-amount" class="form-control" />
              {% if error_virtual_fee_amount %}
              <div class="text-danger">{{ error_virtual_fee_amount }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-virtual-fee-name"><span data-toggle="tooltip" title="{{ help_virtual_fee_name }}">{{ entry_virtual_fee_name }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="shipping_frenet_virtual_fee_name" value="{{ shipping_frenet_virtual_fee_name|escape }}" placeholder="{{ placeholder_virtual_fee_name|escape }}" maxlength="64" id="input-virtual-fee-name" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-debug"><span data-toggle="tooltip" title="{{ help_debug }}">{{ entry_debug }}</span></label>
            <div class="col-sm-10">
              <select name="shipping_frenet_debug" id="input-debug" class="form-control">
                {% if shipping_frenet_debug %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-tax-class">{{ entry_tax_class }}</label>
            <div class="col-sm-10">
              <select name="shipping_frenet_tax_class_id" id="input-tax-class" class="form-control">
                <option value="0">{{ text_none }}</option>
                {% for tax_class in tax_classes %}
                <option value="{{ tax_class.tax_class_id|escape }}"{% if tax_class.tax_class_id == shipping_frenet_tax_class_id %} selected="selected"{% endif %}>{{ tax_class.title|escape }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-geo-zone"><span data-toggle="tooltip" title="{{ help_geo_zone }}">{{ entry_geo_zone }}</span></label>
            <div class="col-sm-10">
              <select name="shipping_frenet_geo_zone_id" id="input-geo-zone" class="form-control">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                <option value="{{ geo_zone.geo_zone_id|escape }}"{% if geo_zone.geo_zone_id == shipping_frenet_geo_zone_id %} selected="selected"{% endif %}>{{ geo_zone.name|escape }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="shipping_frenet_status" id="input-status" class="form-control">
                {% if shipping_frenet_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_frenet_sort_order" value="{{ shipping_frenet_sort_order|escape }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </form>
      </div>
      <div class="panel-footer text-right text-muted" id="frenet-version">{{ text_version }}</div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#input-simulator-limit').on('input', function() {
	var input = $(this);
	var invalid = this.validity.rangeUnderflow || this.validity.stepMismatch || this.validity.badInput;

	this.setCustomValidity(invalid ? input.data('error') : '');

	input.nextAll('.text-danger').remove();
	input.closest('.form-group').toggleClass('has-error', invalid);

	if (invalid) {
		input.after($('<div class="text-danger"></div>').text(input.data('error')));
	}
});
//--></script>
{{ footer }}
