{
    "name": "frenet/opencart3-shipping",
    "description": "Frenet shipping quote extension for OpenCart 3",
    "type": "project",
    "license": "GPL-3.0-only",
    "require": {
        "php": ">=7.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload-dev": {
        "classmap": [
            "upload/system/library/frenet/"
        ],
        "psr-4": {
            "Frenet\\Tests\\": "tests/unit/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "lint": "find upload -name '*.php' -print0 | xargs -0 -n1 php -l",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "compat": "phpcs --standard=phpcs.xml.dist",
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "check": [
            "@cs",
            "@compat",
            "@phpstan",
            "@test"
        ]
    }
}
